# Appwrite
APPWRITE_ENDPOINT=https://appwrite.tstitagency.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Postgres (self-hosted, pgvector) — RAG chunks/embeddings
POSTGRES_URL=

# MinIO object storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_LEDGER_BUCKET=nokware-ledger-files
MINIO_PHOTOS_BUCKET=nokware-report-photos

# Google Gemini
GEMINI_API_KEY=

# Browser origins allowed to call the API (optional). Comma-separated exact
# origins, e.g. https://portal.example.org; localhost on any port is allowed
# by CORS_ORIGIN_REGEX's default. Set CORS_ORIGIN_REGEX= (empty) to turn that off.
CORS_ORIGINS=

# Optional: lets a scheduler call POST /api/jobs/publish-expired with an
# X-Job-Token header. Leave empty to allow only a signed-in MCE to run it.
JOB_TOKEN=

# Optional: how often (seconds) the API itself publishes documents whose clock
# has run out. Default 120. 0 turns it off (then call the job route instead).
DEADLINE_JOB_INTERVAL_SECONDS=120

# Optional: citizen notifications. "log" records each message in the outbox
# without sending it. SMS_PROVIDER=arkesel sends SMS through Arkesel, and
# SMS_PROVIDER=bms through BMS Africa; WHATSAPP_PROVIDER=twilio sends WhatsApp.
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log

# Arkesel SMS, needed when SMS_PROVIDER=arkesel. The sender ID must be approved
# in the Arkesel dashboard (at most 11 characters). ARKESEL_SANDBOX=true (the
# default) has Arkesel accept each message without delivering it or spending credits.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_SANDBOX=true
# Optional: the most SMS pages (credits) sent in a day outside the sandbox. Default 50.
SMS_DAILY_LIMIT=50
# Optional: answers by SMS one number may have in a day, asked for over USSD or
# WhatsApp. Default 5. Their pages count against SMS_DAILY_LIMIT as well; this
# stops one resident using up the day. Nothing is counted while SMS_PROVIDER=log
# or in Arkesel's sandbox, where no message is delivered and none is charged.
# Raise it for a test pass: it takes effect on the next question, and no counts
# or outbox rows have to be cleared for a higher number to apply.
SMS_ANSWER_DAILY_LIMIT=5
# Optional: Arkesel's webhook secret (generated in its dashboard or with
# POST /api/v2/webhooks/secret/rotate). Verifies its signed delivery reports.
ARKESEL_WEBHOOK_SECRET=

# BMS Africa SMS (mNotify's API), needed when SMS_PROVIDER=bms. The sender ID
# must be approved on BMS (at most 11 characters). There is no sandbox: every
# message is sent and charged, within SMS_DAILY_LIMIT. The key travels in the
# request address; the API redacts it from logs and never stores it.
BMS_API_KEY=
BMS_SENDER_ID=
# Optional: how often to ask BMS what became of recent SMS (it sends no
# delivery reports). Default 120 seconds; 0 turns it off.
BMS_DELIVERY_POLL_SECONDS=120
# Optional: turns on USSD. The secret in the USSD callback address you give
# Arkesel: {PUBLIC_API_URL}/api/channels/ussd/{ARKESEL_USSD_TOKEN}. Arkesel doesn't
# sign USSD callbacks yet, so keep it secret. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ARKESEL_USSD_TOKEN=

# Twilio WhatsApp, needed when WHATSAPP_PROVIDER=twilio. TWILIO_WHATSAPP_FROM is
# the WhatsApp address messages come from (whatsapp:+14155238886 is Twilio's
# sandbox). Point the sandbox's "When a message comes in" at
# {PUBLIC_API_URL}/api/channels/whatsapp (POST).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional: the API's public HTTPS address, which Arkesel and Twilio call back
# (an ngrok address in development). Empty: no callbacks are asked for.
PUBLIC_API_URL=

# Optional: Redis, for the messaging channels' short-lived state (USSD menus,
# WhatsApp drafts), per-number limits and the day's SMS page count. Keys start
# "nokware:"; on a shared server give Nokware its own database number, e.g.
# redis://localhost:6379/2. Empty: the SMS count is kept in the API process.
REDIS_URL=

# Optional: spoken replies to WhatsApp voice questions. Gemini's speech model is
# a preview, hence a setting; the voice is one of Gemini's prebuilt voices. Each
# spoken reply is an extra WhatsApp message: VOICE_DAILY_LIMIT caps them per day
# across everyone (past it, the text answer alone is sent).
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon
VOICE_DAILY_LIMIT=20

# Optional: the public site citizens follow their reports on, used in links in
# messages. Default http://localhost:3000.
PUBLIC_SITE_URL=http://localhost:3000

# Optional: how often (seconds) the API deletes citizens' phone numbers whose
# retention (30 days after a case closes) has ended. Default 3600. 0 turns it off.
CONTACT_PURGE_INTERVAL_SECONDS=3600

# Optional: how often (seconds) the API looks for a "received" message a resident
# agreed to that never reached the outbox at all, because the process died between
# the 201 and the background task that sends it. At most 20 a run, and never for a
# report older than 7 days. Default 900. 0 turns it off.
MISSED_MESSAGE_SWEEP_INTERVAL_SECONDS=900

# Optional: the USSD code residents dial (e.g. *920*123#), shown on petition
# pages as a way to confirm a phone number. Needs ARKESEL_USSD_TOKEN. Empty: not shown.
USSD_SERVICE_CODE=

# Optional: petitions. Signatures a petition needs before it goes to the MCE,
# fixed on each petition when it opens (so a change never moves a live goal).
PETITION_THRESHOLD_AREA=150
PETITION_THRESHOLD_METRO=500
# Verification codes by SMS. Only with an approved sender ID: an unregistered
# one's messages are held for about 15 minutes, and a code that late is worse
# than no SMS option. "Nokware" is approved on BMS, so true with
# SMS_PROVIDER=bms; keep false on Arkesel until its sender ID is registered.
# Codes have their own daily page cap, apart from SMS_DAILY_LIMIT.
SMS_VERIFICATION_CODES=false
SMS_CODE_DAILY_LIMIT=30
# The secret behind the stored keyed hash of a confirmed phone number. Empty:
# derived from APPWRITE_API_KEY. Set it before launch, so rotating that key
# doesn't reset who started (and, later, who signed) a petition.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_KEY_SECRET=
